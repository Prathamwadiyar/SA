# Public, verified production origin. Leave empty until known.
NEXT_PUBLIC_SITE_URL=
# Transactional delivery via Resend. Set all three for a working contact form.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Upstash Redis REST rate-limiting. Mandatory in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional GA4 measurement ID, only loaded after analytics consent
NEXT_PUBLIC_GA_ID=
# Optional Search Console verification value
GOOGLE_SITE_VERIFICATION=
